{
  "manifest_version": 3,
  "name": "YouTube History Quick Delete",
  "version": "1.0.0",
  "description": "유튜브 시청 기록에서 영상과 쇼츠를 빠르게 삭제할 수 있는 확장 프로그램",
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/feed/history*",
        "https://m.youtube.com/feed/history*"
      ],
      "js": ["content/contentScript.js"],
      "css": ["content/contentStyles.css"],
      "run_at": "document_idle"
    }
  ]
}
